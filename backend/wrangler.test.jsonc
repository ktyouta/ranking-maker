{
  // ──────────────────────────────────────
  // テスト専用設定（vitest.config.ts から参照）
  //
  // vitest-pool-workers が同梱する Miniflare が ai バインディングの解決に
  // 対応していないため、wrangler.jsonc から ai バインディングのみ除いた
  // コピーとして用意している。IContentModerationRepository はテストでは
  // フェイク実装に差し替える想定のため、テスト実行時に本物の ai バインディング
  // は不要。
  //
  // wrangler.jsonc（本番・ローカル開発用）を変更した場合は、ai バインディング
  // 以外の差分がないか、このファイルとの整合を都度確認すること。
  // ──────────────────────────────────────
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ranking-maker",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-31",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ranking-maker-db",
      "database_id": "local",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "ACCESS_TOKEN_EXPIRES": "15m",
    "REFRESH_TOKEN_EXPIRES": "7d",
    "CORS_ORIGIN": ["http://localhost:5173", "http://localhost:5174"],
    "ALLOW_USER_OPERATION": "true",
    "ENV_PRODUCTION": "false"
  }
}
